@model AromaDom.ViewModels.MaterialEditViewModel

@{
    ViewData["Title"] = "Редактирование материала";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Редактирование материала</h1>
        <p class="page-subtitle">
            Измените данные материала «@Model.Name». Все поля загружены из базы данных.
        </p>
    </div>

    <a asp-action="Index" class="btn btn--outline">← Назад к списку</a>
</div>

<div class="form-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />

        <partial name="_ValidationSummary" />
        <partial name="_MaterialFormFields" model="Model" />

        <div class="form-actions">
            <button type="submit" class="btn btn--accent">Сохранить изменения</button>
            <a asp-action="Products" asp-route-id="@Model.Id" class="btn btn--outline">
                Продукция материала
            </a>
            <a asp-action="Index" class="btn btn--outline">Отмена</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
